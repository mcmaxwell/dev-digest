{
  "name": "@devdigest/mcp",
  "version": "0.0.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "private": true,
  "type": "module",
  "description": "devdigest-mcp - local MCP (stdio) server exposing DevDigest reviewer agents, findings and conventions to an editor agent. Talks to the local API over HTTP only; no DB, no framework, no secrets in the process.",
  "bin": {
    "devdigest-mcp": "./bin/devdigest-mcp",
    "devdigest": "./bin/devdigest"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "budget": "tsx scripts/token-budget.ts",
    "test": "vitest run --exclude '**/*.it.test.ts'",
    "test:it": "vitest run .it.test",
    "inspect": "npx @modelcontextprotocol/inspector ./bin/devdigest-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^17.4.3",
    "js-tiktoken": "^1.0.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
