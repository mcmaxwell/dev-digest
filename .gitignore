node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
# e2e's isolated Next build cache (scripts/e2e.sh NEXT_DIST_DIR)
.next-e2e/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# Handoff state between agents, not source: the implementer writes it, the
# reviewers read it, and it describes one working tree at one moment.
.claude/last-change.json

# `server/src/vendor/**` and `client/src/vendor/**` are checked in on purpose:
# the canonical Zod contracts and the vendored UI kit. A personal global
# gitignore with a bare `vendor` pattern swallows NEW files there while every
# already-tracked file keeps working, so the breakage is invisible locally and
# only surfaces as a broken barrel export on a fresh clone. A repo .gitignore
# outranks core.excludesFile, so these two lines make that impossible.
!server/src/vendor/
!client/src/vendor/

# Python bytecode from the skills' helper scripts. Running collect.py or
# check_report.py leaves these behind, and they are build output.
__pycache__/
*.pyc

# Skill eval RUN OUTPUTS. An iteration is one measurement of one skill version:
# reproducible from the fixtures plus the snapshot it names, and large. The
# sources - evals.json, fixtures/, the notes - are tracked; these are not.
.claude/skills/*/evals/iteration-*/
.claude/skills/*/evals/skill-snapshot*/
# Harness eval outputs only. The audits/ directories are INPUT - the baseline
# report a case is measured against - so they stay tracked; without them the
# case cannot be reproduced from a clean checkout.
.claude/*-evals/*/run-*/outputs/
.claude/worktrees/
